# ============================================
# CREDENTIAL VAULT TEMPLATE
# Meauxbility & Inner Animals
# ============================================
# Copy this file to .env and fill in your credentials
# cp env.example .env
# ============================================

# --------------------------------------------
# SUPABASE CONFIGURATION
# --------------------------------------------
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --------------------------------------------
# CLOUDFLARE CONFIGURATION
# --------------------------------------------
# Main API credentials
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_EMAIL=your_email@example.com

# R2 Storage Buckets (already created)
CLOUDFLARE_R2_BUCKET_MEAUXBILITY=meauxbility-assets
CLOUDFLARE_R2_BUCKET_INNERANIMALS=inneranimals-assets
CLOUDFLARE_R2_BUCKET_ADMIN=iaudodidact-assets

# R2 Access Credentials
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key

# Pages/Workers
CLOUDFLARE_PAGES_PROJECT_NAME=your_project_name
CLOUDFLARE_WORKERS_SUBDOMAIN=your_subdomain

# --------------------------------------------
# OPENAI CONFIGURATION
# --------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_ORGANIZATION_ID=org-your_org_id

# --------------------------------------------
# ANTHROPIC CLAUDE CONFIGURATION
# --------------------------------------------
VITE_ANTHROPIC_API_KEY=sk-ant-your_anthropic_key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key

# --------------------------------------------
# GITHUB CONFIGURATION
# --------------------------------------------
VITE_GITHUB_TOKEN=ghp_your_github_token
GITHUB_TOKEN=ghp_your_github_token
GITHUB_ORG=your_github_org
GITHUB_REPO=your_repo_name

# --------------------------------------------
# VERCEL CONFIGURATION
# --------------------------------------------
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_TEAM_ID=your_vercel_team_id

# --------------------------------------------
# GOOGLE SERVICES CONFIGURATION
# --------------------------------------------
# Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Cloud Platform
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_API_KEY=your_google_api_key
GOOGLE_PROJECT_ID=your_project_id

# OAuth
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_secret

# --------------------------------------------
# STRIPE CONFIGURATION
# --------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --------------------------------------------
# ADDITIONAL SERVICES (Optional)
# --------------------------------------------
# Sentry
VITE_SENTRY_DSN=https://your_sentry_dsn@sentry.io

# SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_key

# Twilio
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# --------------------------------------------
# APPLICATION CONFIGURATION
# --------------------------------------------
NODE_ENV=development
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PAYMENTS=true

# --------------------------------------------
# SECURITY SETTINGS
# --------------------------------------------
JWT_SECRET=generate_a_strong_random_string_here
ENCRYPTION_KEY=generate_a_strong_random_string_here
SESSION_SECRET=generate_a_strong_random_string_here
